      "required": true
    },
    "discussion": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::discussion.discussion",
      "inversedBy": "replies"
    },
    "blog_post": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-post.blog-post",
      "inversedBy": "comments"
    },
    "solved_discussions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::discussion.discussion",
      "mappedBy": "solution"
    },
    "likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::like.like",
      "mappedBy": "reply"
    }

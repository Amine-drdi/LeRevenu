{
  "kind": "collectionType",
  "collectionName": "replies",
  "info": {
    "singularName": "reply",
    "pluralName": "replies",
    "displayName": "Réponse",
    "description": "Réponse ou commentaire publié sur une discussion ou un billet"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "content": {
      "type": "richtext",
      "required": true
    },
    "author": {
      "type": "relation",

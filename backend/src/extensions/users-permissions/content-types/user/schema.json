{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User",
    "description": ""
  },
  "options": {
    "timestamps": true,
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "discussions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::discussion.discussion",
      "mappedBy": "author"
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reply.reply",
      "mappedBy": "author"
    },
    "bio": {
      "type": "text"
    },
    "title": {
      "type": "string",
      "description": "Intitulé professionnel vérifié (étiquette « Expertise vérifiée »)"
    },
    "is_redaction": {
      "type": "boolean",
      "default": false
    },
    "is_moderator": {
      "type": "boolean",
      "default": false
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "badges": {
      "type": "json",
      "description": "Codes de badges déjà attribués (attribués par sync, jamais par le client)"
    },
    "interests": {
      "type": "json",
      "description": "Slugs de catégories choisis à l'onboarding (fil « Pour vous »)"
    },
    "level": {
      "type": "integer",
      "default": 0,
      "description": "Dernier niveau notifié (comparaison pour la notification de niveau supérieur)"
    },
    "blog_posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "author"
    },
    "likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::like.like",
      "mappedBy": "user"
    },
    "follows": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::follow.follow",
      "mappedBy": "user"
    },
    "notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "user"
    },
    "actor_notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "actor"
    },
    "poll_votes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::poll-vote.poll-vote",
      "mappedBy": "user"
    },
    "event_rsvps": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-rsvp.event-rsvp",
      "mappedBy": "user"
    }
  }
}

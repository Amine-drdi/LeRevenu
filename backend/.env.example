# ============================================================================
#  Le Revenu — Backend Strapi v5 : MODÈLE de configuration
#  → Copier ce fichier en `.env` puis remplacer CHAQUE placeholder.
#  → AUCUN secret réel dans ce fichier (il est commité).
#  → `.env` est ignoré par Git (voir .gitignore racine).
# ============================================================================

# ----- Serveur -----
HOST=0.0.0.0
PORT=1337

# ----- Base de données PostgreSQL -----
# Laisser DATABASE_URL vide pour utiliser host/port/name/user/password.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=le_revenu_forum
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=__YOUR_DB_PASSWORD__
DATABASE_SSL=false
DATABASE_URL=

# ----- Secrets Strapi (jamais commités, jamais partagés) -----
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_KEYS = 4 clés séparées par des virgules.
APP_KEYS=__GENERATE_4_KEYS__
API_TOKEN_SALT=__GENERATE__
ADMIN_JWT_SECRET=__GENERATE__
TRANSFER_TOKEN_SALT=__GENERATE__

# ----- JWT du plugin Users & Permissions (auth du forum) -----
JWT_SECRET=__GENERATE__

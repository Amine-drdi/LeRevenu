################################################################################
# Le Revenu — Forum communautaire : règles Git racine (monorepo)
################################################################################

############################
# Secrets & environnement
# Règle absolue : aucun .env ne doit être commité. Seul le modèle
# (.env.example, placeholders sans secret réel) est versionné.
############################

.env
.env.*
!.env.example

############################
# Dépendances
############################

node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

############################
# Builds & caches
############################

dist/
build/
.next/
out/
*.tsbuildinfo
.eslintcache
.turbo/

############################
# Strapi (backend)
############################

.tmp/
.strapi/
.strapi-updater.json
.strapi-cloud.json
exports/

# Médias uploadés localement (Strapi) — conserver le dossier, pas son contenu
backend/public/uploads/*
!backend/public/uploads/.gitkeep

############################
# Tests & couverture
############################

coverage/
*.lcov

############################
# Logs
############################

*.log
logs/
pids/
*.pid

############################
# Système / éditeurs
############################

.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.idea/
.vscode/*
!.vscode/extensions.json

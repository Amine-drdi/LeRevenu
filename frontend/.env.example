# ============================================================================
#  Le Revenu — Frontend Next.js : MODÈLE de configuration
#  → Copier ce fichier en `.env.local` pour le développement.
#  → Préfixe NEXT_PUBLIC_ = valeur embarquée dans le bundle navigateur :
#    ne jamais y mettre de secret (JWT, mots de passe, clés API).
# ============================================================================

# URL publique de l'API Strapi (côté serveur Next ET navigateur)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
